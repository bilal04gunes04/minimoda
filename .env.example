# Binance API anahtarlarinizi buraya girin.
# Testnet anahtari almak icin: https://testnet.binance.vision/
BINANCE_API_KEY=api_anahtariniz
BINANCE_API_SECRET=gizli_anahtariniz

# Telegram kontrol paneli (istege bagli, config.yaml'da telegram.enabled: true yapin)
# 1) Telegram'da @BotFather'a /newbot yazip bot olusturun -> token'i buraya yazin
# 2) @userinfobot'a mesaj atip kendi chat ID'nizi ogrenin -> buraya yazin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
